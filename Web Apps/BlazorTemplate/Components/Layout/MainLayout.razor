@inherits LayoutComponentBase
@inject UserServiceAuthClient AuthClient

<div class="app-shell">
    <header class="app-header">
        <span class="app-title">Blazor Template Demo</span>
        <nav class="app-nav">
            <NavLink href="/" Match="NavLinkMatch.All">Home</NavLink>
            <NavLink href="/work-orders">Work Orders</NavLink>
        </nav>
        <span class="user-display" title="@_userTitle">@_displayName</span>
    </header>
    <main class="app-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">??</span>
</div>

@code {
    private string _displayName = "Loading…";
    private string? _userTitle;

    protected override async Task OnInitializedAsync()
    {
        var status = await AuthClient.GetAuthStatusAsync();
        if (status == null)
        {
            _displayName = "Not signed in";
            return;
        }

        _displayName = status.DisplayName;
        _userTitle = status.UserId ?? status.Name;
    }
}
