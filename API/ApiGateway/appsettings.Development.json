{
  "ReverseProxy": {
    "Routes": {
      "workorder-route": {
        "ClusterId": "workorder-cluster",
        "Match": { "Path": "/api/workorderservice/{**catch-all}" }
      },
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": { "Path": "/api/userservice/{**catch-all}" }
      },
      "traveler-route": {
        "ClusterId": "traveler-cluster",
        "Match": { "Path": "/api/travelerservice/{**catch-all}" }
      },
      "fma-route": {
        "ClusterId": "fma-cluster",
        "Match": { "Path": "/api/fmaservice/{**catch-all}" }
      },
      "print-route": {
        "ClusterId": "print-cluster",
        "Match": { "Path": "/api/printservice/{**catch-all}" }
      },
      "sapinterface-route": {
        "ClusterId": "sapinterface-cluster",
        "Match": { "Path": "/api/sapinterfaceservice/{**catch-all}" }
      },
      "mrsi-route": {
        "ClusterId": "mrsi-cluster",
        "Match": { "Path": "/api/mrsiservice/{**catch-all}" }
      },
      "part-route": {
        "ClusterId": "part-cluster",
        "Match": { "Path": "/api/partservice/{**catch-all}" }
      }
    },
    "Clusters": {
      "workorder-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5292/" }
        }
      },
      "user-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5293/" }
        }
      },
      "traveler-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5294/" }
        }
      },
      "fma-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5295/" }
        }
      },
      "print-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5296/" }
        }
      },
      "sapinterface-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5298/" }
        }
      },
      "mrsi-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5297/" }
        }
      },
      "part-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5299/" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
